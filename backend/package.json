{
  "name": "inventory-hub-backend",
  "version": "1.0.0",
  "description": "Inventory Hub Backend Service (Device A)",
  "main": "dist/api/server.js",
  "scripts": {
    "sync:contract": "node -e \"require('fs').copyFileSync('../contract/types.ts','src/types/contract.ts')\"",
    "api": "tsx src/api/server.ts",
    "worker:outbox": "tsx src/workers/outboxPublisher.ts",
    "worker:inventory": "tsx src/workers/inventoryWorker.ts",
    "worker:notify": "tsx src/workers/notificationWorker.ts",
    "worker:index": "tsx src/workers/searchIndexer.ts",
    "dev:all": "concurrently -n \"API,OUTBOX,INVENTORY,NOTIFY,INDEX\" -c \"blue,green,magenta,yellow,cyan\" \"npm run api\" \"npm run worker:outbox\" \"npm run worker:inventory\" \"npm run worker:notify\" \"npm run worker:index\"",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "kafka:topics": "tsx src/scripts/createTopics.ts",
    "os:index": "tsx src/scripts/createIndex.ts",
    "os:reindex": "tsx src/scripts/reindexAll.ts",
    "test:concurrency": "tsx src/scripts/concurrencyTest.ts",
    "contract:check": "tsx src/scripts/contractCheck.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
