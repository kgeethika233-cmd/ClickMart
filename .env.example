# Backend Environment Variables (Placeholders only - never commit real secrets)
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_KEY=dev-secret-admin-key-123
JWT_SECRET=dev-jwt-secret-key-123

# Aiven PostgreSQL
PG_HOST=your-pg-service.a.aivencloud.com
PG_PORT=20835
PG_USER=avnadmin
PG_PASSWORD=your_pg_password
PG_DATABASE=defaultdb
PG_CA_PATH=./certs/ca.pem

# Aiven Apache Kafka (Topic limit <= 5 on Free Tier)
KAFKA_BROKER=your-kafka-service.a.aivencloud.com:20848
KAFKA_USER=avnadmin
KAFKA_PASSWORD=your_kafka_password
KAFKA_SASL_MECHANISM=PLAIN

# Aiven OpenSearch
OS_HOST=your-opensearch-service.h.aivencloud.com
OS_PORT=20835
OS_USER=avnadmin
OS_PASSWORD=your_os_password

